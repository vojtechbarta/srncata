# Zkopíruj do .env a uprav.
#
# Pro lokální vývoj/test (výchozí) stačí nechat VITE_USE_EMULATORS=true —
# appka pak běží proti Firebase emulátorům a žádné další hodnoty níže
# nejsou potřeba (viz README.md, sekce "Lokální vývoj").
#
# Pro nasazení na skutečný Firebase projekt nastav VITE_USE_EMULATORS=false
# a doplň hodnoty z Firebase Console → Project settings → Your apps → SDK config.
VITE_USE_EMULATORS=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
