rules_version = '2';

// Malý důvěryhodný tým (v jednotkách/nízkých desítkách lidí) — pravidla jsou
// záměrně jednoduchá: kdokoliv na seznamu týmu smí číst a psát všechno.
// Členství se ověřuje podle e-mailu z Google přihlášení, doc ID v `team`
// odpovídá e-mailu člena.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeamMember() {
      return request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/team/$(request.auth.token.email));
    }

    match /team/{memberId} {
      // Přečíst vlastní záznam smí kdokoliv přihlášený rovnou porovnáním
      // e-mailu (bez exists() na sebe sama) — tenhle konkrétní dotaz dělá
      // appka hned po přihlášení, aby zjistila, jestli je v týmu, a
      // sebereferenční exists() přes streamované SDK spojení v emulátoru
      // uměl vracet "evaluation error". Čtení/psaní ostatních záznamů
      // (Piloti stránka) pořád jde přes isTeamMember().
      allow get: if request.auth != null && request.auth.token.email == memberId;
      allow list, write: if isTeamMember();
    }

    match /drones/{droneId} {
      allow read, write: if isTeamMember();
    }

    match /events/{eventId} {
      allow read, write: if isTeamMember();
    }

    // Veřejný blog: kdokoliv smí číst zveřejněné příspěvky (i bez
    // přihlášení), koncepty a psaní/mazání jsou jen pro tým.
    match /posts/{postId} {
      allow get, list: if resource.data.status == 'published' || isTeamMember();
      allow write: if isTeamMember();
    }
  }
}
